{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: IPC to the Rust host only. No FS plugin, no provider network, no generic shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "notification:default",
    "allow-agent-ipc"
  ]
}
